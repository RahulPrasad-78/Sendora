{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sendora-backend-bvq2.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://sendora-backend-bvq2.onrender.com/api"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
