{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://CHANGE_ME_TO_YOUR_GOOGLE_CLOUD_RUN_URL/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://CHANGE_ME_TO_YOUR_GOOGLE_CLOUD_RUN_URL/api"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
