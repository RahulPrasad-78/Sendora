# =================================================================
# Sendora - Environment Configuration
# =================================================================
# For Local Development:
#   Copy this file to 'backend/.env' (or root '.env'):
#   cp .env.example backend/.env
#
# For Vercel Deployment:
#   Add these environment variables in your Vercel Project Settings:
#   Settings -> Environment Variables -> Add Variable
# =================================================================

# -----------------------------------------------------------------
# Server Configuration (Local only, ignored on Vercel)
# -----------------------------------------------------------------
PORT=7000

# -----------------------------------------------------------------
# MongoDB Connection (Atlas recommended for cloud & Vercel)
# -----------------------------------------------------------------
# Atlas connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sendora?retryWrites=true&w=majority

# -----------------------------------------------------------------
# Google Gemini API
# -----------------------------------------------------------------
# Used for AI resume tailoring, email generation, and categorization.
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# Candidate Profile & Signatures
# -----------------------------------------------------------------
USER_NAME="Rahul Prasad"
USER_ROLE="Full Stack Engineer"
USER_SKILLS="Node.js, Express, React, MongoDB, JavaScript, TypeScript, TailwindCSS"
USER_RESUME_SUMMARY="Full Stack Engineer experienced in building high-performance web applications, AI integrations, and distributed microservices."

# -----------------------------------------------------------------
# Professional Links (Appended to email signatures & resumes)
# -----------------------------------------------------------------
USER_LINKEDIN="https://www.linkedin.com/in/your-profile"
USER_GITHUB="https://github.com/RahulPrasad-78"
USER_RESUME="https://drive.google.com/file/d/your-resume-link/view"
USER_LEETCODE="https://leetcode.com/u/your-username/"

# -----------------------------------------------------------------
# SMTP Email Dispatch (Gmail App Password)
# -----------------------------------------------------------------
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=your_email@gmail.com

# -----------------------------------------------------------------
# Security & Portfolio Owner Access Key
# -----------------------------------------------------------------
# Passcode entered in top-right "Unlock Owner Mode" to dispatch emails
# and edit templates. Recruiters and guests browse in safe viewer mode.
OWNER_PASSCODE=SendoraOwner2026
