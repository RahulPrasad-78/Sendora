{
  "name": "sendora",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "start": "node backend/server.js",
    "install:all": "npm install && npm --prefix backend install --no-save && npm --prefix frontend install --no-save",
    "install-all": "npm run install:all",
    "setup": "npm run install:all",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.7.4",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
