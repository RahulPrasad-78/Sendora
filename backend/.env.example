# =================================================================
# Sendora - Comprehensive Environment Configuration (.env.example)
# =================================================================
#
# QUICK SETUP FOR LOCAL DEVELOPMENT:
#   1. Copy this file to 'backend/.env':
#      cp backend/.env.example backend/.env
#   2. Fill in your GEMINI_API_KEY, MONGO_URI, and SMTP credentials.
#
# QUICK SETUP FOR VERCEL CLOUD DEPLOYMENT:
#   Go to your Vercel Project Dashboard:
#   Settings -> Environment Variables -> Add Variable
#   Add the keys below (especially GEMINI_API_KEY, MONGO_URI, OWNER_PASSCODE).
# =================================================================


# =================================================================
# 1. CORE SERVER & RUNTIME SETTINGS
# =================================================================
# Port for the local Express backend server (default: 7000)
# (Note: On Vercel, PORT is automatically managed by the serverless runtime)
PORT=7000

# Environment mode ('development' or 'production')
NODE_ENV=development


# =================================================================
# 2. DATABASE CONFIGURATION (MONGODB ATLAS)
# =================================================================
# MongoDB connection URI.
# Required for persistent email logs, saved tailored resumes, and knowledge base.
# If omitted or temporarily unreachable, Sendora operates safely in-memory.
#
# - Local instance: mongodb://127.0.0.1:27017/sendora
# - MongoDB Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sendora?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sendora?retryWrites=true&w=majority


# =================================================================
# 3. AI ENGINE (GOOGLE GEMINI API)
# =================================================================
# Required for:
#   - Real-time ATS LaTeX resume tailoring
#   - Cold email drafting & recruiter matching
#   - Inbound email categorization & auto-response generation
#
# Get your free Gemini API key at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere123456789


# =================================================================
# 4. CANDIDATE PROFILE NAME
# =================================================================
# This value populates your name in cold email signatures.
# (Skills, Role, and Summary are now pulled dynamically from your MongoDB database)
USER_NAME="Rahul Prasad"


# =================================================================
# 5. CANDIDATE PORTFOLIO & SOCIAL LINKS
# =================================================================
# Automatically injected into cold email signatures, resume contact
# tables, and project links.
USER_LINKEDIN="https://www.linkedin.com/in/your-profile"
USER_GITHUB="https://github.com/RahulPrasad-78"
USER_RESUME="https://drive.google.com/file/d/your-google-drive-resume-link/view"
USER_LEETCODE="https://leetcode.com/u/your-username/"


# =================================================================
# 6. SMTP DISPATCH (GMAIL / OUTLOOK / CUSTOM SMTP)
# =================================================================
# Required to send recruiter emails directly from the Sendora web UI.
# For Gmail:
#   1. Enable 2-Step Verification on your Google account.
#   2. Generate a 16-character App Password at:
#      https://myaccount.google.com/apppasswords
#   3. Use port 465 (SSL) or 587 (TLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM=your_email@gmail.com


# =================================================================
# 7. SECURITY & OWNER ACCESS KEY
# =================================================================
# Passcode required to unlock full Owner Mode in the deployed UI.
# Guests & recruiters browsing your live Vercel link will be in safe,
# read-only Viewer Mode (can preview AI generations, but cannot send
# real emails or delete records from MongoDB).
#
# Enter this code via the "Unlock Owner Mode" button in the top navbar.
# (Also accepts OWNER_SECRET_KEY as alias)
OWNER_PASSCODE=SendoraOwner2026
# OWNER_SECRET_KEY=SendoraOwner2026
