# =================================================================
# Sendora - Environment Configuration
# =================================================================
# Copy this file to '.env' inside the 'backend' directory (or root)
# and fill in your actual credentials.
#
# Quick setup:
#   cp backend/.env.example backend/.env
# =================================================================

# -----------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------
PORT=7000

# -----------------------------------------------------------------
# MongoDB Connection
# -----------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/sendora
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/sendora?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sendora

# -----------------------------------------------------------------
# Google Gemini API
# -----------------------------------------------------------------
# Used for AI cold email generation, email categorization, and smart replies.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# User / Candidate Profile Defaults
# -----------------------------------------------------------------
USER_NAME="Your Full Name"
USER_ROLE="Full Stack Developer"
USER_SKILLS="Node.js, Express, React, MongoDB, JavaScript, TypeScript"
USER_RESUME_SUMMARY="Passionate full stack developer with experience in modern web technologies and building scalable applications."

# -----------------------------------------------------------------
# Professional Links (Appended to email signatures & footer)
# -----------------------------------------------------------------
USER_LINKEDIN="https://www.linkedin.com/in/your-profile"
USER_GITHUB="https://github.com/your-username"
USER_RESUME="https://drive.google.com/file/d/your-resume-link/view"
USER_LEETCODE="https://leetcode.com/u/your-username/"

# -----------------------------------------------------------------
# SMTP Email Dispatch (Gmail App Password)
# -----------------------------------------------------------------
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=your_email@gmail.com

# -----------------------------------------------------------------
# Security & Portfolio Owner Access Key
# -----------------------------------------------------------------
# Secret passcode for the top-right Owner unlock on deployed demo.
# Recruiters browse in safe read-only viewer mode.
OWNER_PASSCODE=SendoraOwner2026
